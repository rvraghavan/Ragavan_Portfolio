# SMTP Server Configuration for Sending Portfolio Inquiries
# For Gmail: Use smtp.gmail.com with an App Password (generated in Google Account Security -> App Passwords)
# For Outlook/Hotmail: smtp-mail.outlook.com (Port: 587)
# For Custom Domain/cPanel/Webmail: e.g., mail.yourdomain.com (Port: 465 or 587)

SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password-or-email-password

# The destination address where inquiry messages will be delivered:
RECEIVER_EMAIL=rvraghavan.it@gmail.com

# Backend Server Port
PORT=5000
